# Phase 7 — paper-trading execution. Copy this file to .env and fill in the values
# on the execution machine. .env is gitignored and must never be committed.

# Alpaca PAPER credentials (create at https://alpaca.markets/, paper account).
# The base URL MUST be the paper endpoint — the broker refuses anything else.
ALPACA_API_KEY=your-paper-api-key
ALPACA_SECRET_KEY=your-paper-secret-key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Discord webhook for the daily briefing (Server Settings -> Integrations -> Webhooks).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy

# Strategy and risk tunables (optional; defaults shown).
ALPHALAB_STRATEGY=ts_momentum
ALPHALAB_STRATEGY_LOOKBACK=126
ALPHALAB_TARGET_VOL=0.10
ALPHALAB_VOL_LOOKBACK=63
ALPHALAB_MAX_LEVERAGE=3.0
ALPHALAB_NO_TRADE_BAND=1.0
ALPHALAB_MAX_ORDER_NOTIONAL=10000
ALPHALAB_HISTORY_DAYS=400

# dry_run=true computes and logs orders WITHOUT submitting them. Set to false only
# once you are ready to place paper orders.
ALPHALAB_DRY_RUN=true

# Skip the broker entirely and use an in-memory fake (for wiring smoke tests).
ALPHALAB_USE_FAKE_BROKER=false

# Comma-separated ticker universe (defaults to the sector ETFs).
# ALPHALAB_UNIVERSE=XLB,XLC,XLE,XLF,XLI,XLK,XLP,XLRE,XLU,XLV,XLY
